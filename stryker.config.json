{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/decimalValue.ts",
    "src/atdlValue.ts",
    "src/StateRuleEvaluator.ts",
    "src/stateTransitions.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "dryRunTimeoutMinutes": 5,
  "thresholds": {
    "high": 80,
    "low": 55,
    "break": 55
  },
  "cleanTempDir": false
}
