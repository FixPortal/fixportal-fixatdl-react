[
  {
    "name": "initial-false-inverts-enabled-and-visible",
    "controls": [
      {
        "id": "trigger",
        "type": "TextField_t",
        "initValue": "off",
        "stateRules": []
      },
      {
        "id": "target",
        "type": "TextField_t",
        "initValue": "saved",
        "stateRules": [
          {
            "effect": "enabled",
            "targetValue": true,
            "targetStringValue": null,
            "expression": {
              "kind": "compare",
              "operator": "==",
              "field": "trigger",
              "value": "on",
              "children": null
            }
          },
          {
            "effect": "visible",
            "targetValue": true,
            "targetStringValue": null,
            "expression": {
              "kind": "compare",
              "operator": "==",
              "field": "trigger",
              "value": "on",
              "children": null
            }
          }
        ]
      }
    ],
    "steps": [
      {
        "expected": {
          "values": {
            "target": "saved"
          },
          "states": {
            "target": {
              "enabled": false,
              "visible": false
            }
          }
        }
      },
      {
        "set": {
          "id": "trigger",
          "value": "on"
        },
        "expected": {
          "states": {
            "target": {
              "enabled": true,
              "visible": true
            }
          }
        }
      },
      {
        "set": {
          "id": "trigger",
          "value": "off"
        },
        "expected": {
          "states": {
            "target": {
              "enabled": false,
              "visible": false
            }
          }
        }
      }
    ]
  },
