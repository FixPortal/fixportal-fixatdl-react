  {
    "name": "reverse-document-order-cascade-settles-in-one-edit",
    "controls": [
      {
        "id": "c",
        "type": "TextField_t",
        "initValue": null,
        "stateRules": [
          {
            "effect": "value",
            "targetValue": false,
            "targetStringValue": "done",
            "expression": {
              "kind": "compare",
              "operator": "==",
              "field": "b",
              "value": "go",
              "children": null
            }
          }
        ]
      },
      {
        "id": "b",
        "type": "TextField_t",
        "initValue": null,
        "stateRules": [
          {
            "effect": "value",
            "targetValue": false,
            "targetStringValue": "go",
            "expression": {
              "kind": "compare",
              "operator": "==",
              "field": "a",
              "value": "go",
              "children": null
            }
          }
        ]
      },
      {
        "id": "a",
        "type": "TextField_t",
        "initValue": "stop",
        "stateRules": []
      }
    ],
    "steps": [
      {
        "expected": {
          "values": {
            "a": "stop",
            "b": null,
            "c": null
          }
        }
      },
      {
        "set": {
          "id": "a",
          "value": "go"
        },
        "expected": {
          "values": {
            "a": "go",
            "b": "go",
            "c": "done"
          }
        }
      }
    ]
  },
