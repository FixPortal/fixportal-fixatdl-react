{
  "name": "@fix-portal/fixatdl-react",
  "version": "0.4.1",
  "description": "React FIXatdl strategy forms rendered from the FixPortal.FixAtdl.Contracts JSON contract",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FixPortal/fixportal-fixatdl-react.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "workspaces": [
    "examples/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/assert-docs.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:producer-contract": "node scripts/test-producer-contract.mjs",
    "test:coverage": "vitest run --coverage",
    "build": "vite build && tsc -p tsconfig.build.json && tailwindcss -i styles/index.css -o dist/styles.css",
    "prepack": "npm run build",
    "dev": "npm run build && npm run dev --workspace @fix-portal/fixatdl-react-workbench",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "gate": "npm run format && npm run lint && npm run typecheck && npm run test",
    "test:mutation": "stryker run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    },
    "qs": "6.16.0"
  }
}
